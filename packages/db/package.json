    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261026.1",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.2",
    "wrangler": "4.153.0"
  }
}
