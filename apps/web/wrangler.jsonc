{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Local dev uses top-level bindings; preview/prod override below.
  // Prod D1/R2 ids are provisioned in step 04 (hot-voyage-04-launch).
  "name": "hot-voyage",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  // NOTE: no `main` field. The Cloudflare Vite plugin backing
  // @astrojs/cloudflare throws on first build when `main` points at
  // dist/_worker.js before it exists. The adapter emits _worker.js and a
  // generated wrangler.json into dist/ at build time; `wrangler deploy`
  // picks the entry up from there. Keep bindings here, not the entry.
  // DEPLOY INVOCATION: run `wrangler deploy` from apps/web (or
  // `bun run cf:deploy` from the repo root) with NO --config flag, so
  // Wrangler follows .wrangler/deploy/config.json to the generated
  // dist/server/wrangler.json. Passing --config explicitly disables that
  // redirect and deploys this file as an assets-only Worker, which Wrangler
  // rejects ("Cannot use assets with a binding in an assets-only Worker")
  // because D1/R2 bindings are present without a Worker script.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hot-voyage-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "hot-voyage-images-dev"
    }
  ],
  // Pinned id of the auto-provisioned "hot-voyage-session" KV namespace.
  // The adapter injects an id-less SESSION entry when none is declared,
  // which makes every deploy try to re-create the namespace (error 10014).
  // Declaring it here makes the adapter back off (see cloudflareConfigCustomizer).
  // Preview/production envs need their own KV ids when provisioned (step 04).
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "4b01a2425abf402fa423c039541b9c88"
    }
  ],
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hot-voyage-preview",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "../../packages/db/drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "IMAGES",
          "bucket_name": "hot-voyage-images-preview"
        }
      ]
    },
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hot-voyage-prod",
          "database_id": "REPLACE_WITH_PROD_D1_ID_IN_STEP_04",
          "migrations_dir": "../../packages/db/drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "IMAGES",
          "bucket_name": "hot-voyage-images-prod"
        }
      ]
    }
  }
}
