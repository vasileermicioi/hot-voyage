---
import { buildSrcset, r2PublicUrl, sizesFor } from "@hot-voyage/lib";

interface GalleryImage {
  r2Key: string;
  alt?: string;
}

interface Props {
  images: GalleryImage[];
  title: string;
  publicHost: string;
  variant?: "card" | "gallery";
}

const { images, title, publicHost, variant = "gallery" } = Astro.props;
const first = images[0];
---

{images.length > 0 && first ? (
  <figure class="gallery">
    <img
      src={r2PublicUrl(first.r2Key, publicHost)}
      srcset={buildSrcset(first.r2Key, publicHost)}
      sizes={sizesFor(variant)}
      alt={first.alt || title}
      loading="lazy"
      decoding="async"
    />
    {images.length > 1 && (
      <figcaption>{images.length} photos</figcaption>
    )}
  </figure>
) : (
  <div class="gallery gallery--empty" role="img" aria-label={`${title} photo coming soon`}>
    Photo coming soon
  </div>
)}

<style>
  .gallery {
    margin: 0;
    border: var(--hv-border);
    border-radius: var(--hv-radius);
    overflow: hidden;
    background: var(--hv-paper);
  }

  .gallery img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .gallery figcaption {
    padding: 0.375rem 0.75rem;
    font-size: var(--hv-type-small);
    font-weight: 700;
  }

  .gallery--empty {
    padding: 2rem;
    text-align: center;
    font-weight: 700;
    box-shadow: var(--hv-shadow-small);
  }
</style>
